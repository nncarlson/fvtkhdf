#include "vtkhdf_assert.inc"

#:set reals = [('real32','real(real32)','H5T_NATIVE_FLOAT'), ('real64','real(real64)','H5T_NATIVE_DOUBLE')]

module vtkhdf_image_file_type

  use,intrinsic :: iso_fortran_env
  use vtkhdf_structured_base_class
  use vtkhdf_h5_c_binding
  use vtkhdf_h5
  use vtkhdf_h5e_context_type
  use vtkhdf_data_handle_types
  use vtkhdf_version_param
  use vtkhdf_file_modes, only: VTKHDF_STATIC, VTKHDF_FIXED_MESH
  implicit none
  private

  public :: vtkhdf_version, VTKHDF_STATIC, VTKHDF_FIXED_MESH
  public :: vtkhdf_cell_data_handle, vtkhdf_point_data_handle, vtkhdf_field_data_handle

  type, extends(vtkhdf_structured_base), public :: vtkhdf_image_file
    private
  contains
    procedure :: dataset_type, supports_mode
    generic :: write_mesh => write_mesh_real32, write_mesh_real64
    procedure, private :: write_mesh_real32, write_mesh_real64
  end type

contains

  pure logical function supports_mode(this, mode)
    class(vtkhdf_image_file), intent(in) :: this
    integer, intent(in) :: mode
    supports_mode = mode == VTKHDF_STATIC .or. mode == VTKHDF_FIXED_MESH
  end function

  pure function dataset_type(this) result(name)
    class(vtkhdf_image_file), intent(in) :: this
    character(:), allocatable :: name
    name = 'ImageData'
  end function

#:for kind, decl, h5type in reals
  subroutine write_mesh_${kind}$(this, point_bounds, origin, spacing, direction)
    class(vtkhdf_image_file), intent(inout) :: this
    integer(int32), intent(in) :: point_bounds(3,2)
    ${decl}$, intent(in) :: origin(3), spacing(3)
    ${decl}$, intent(in), optional :: direction(3,3)
    real(real64) :: matrix(3,3)
    type(vtkhdf_h5e_context) :: err_ctx
    call err_ctx%capture()
    call this%define_logical_grid(point_bounds)
    matrix = reshape([1.0_real64,0.0_real64,0.0_real64, 0.0_real64,1.0_real64,0.0_real64, &
        0.0_real64,0.0_real64,1.0_real64],[3,3])
    if (present(direction)) matrix = real(direction,real64)
    ASSERT(this%ctx%identical(real(origin,real64)))
    ASSERT(this%ctx%identical(real(spacing,real64)))
    ASSERT(this%ctx%identical(reshape(matrix,[9])))
    ! VTK interleaves the lower and upper bounds for each axis.
    call h5_write_attr(this%ctx, this%root(), 'WholeExtent', reshape(transpose(point_bounds),[6]))
    call h5_write_attr(this%ctx, this%root(), 'Origin', real(origin,real64))
    call h5_write_attr(this%ctx, this%root(), 'Spacing', real(spacing,real64))
    ! VTK stores the nine matrix entries in row-major order.
    call h5_write_attr(this%ctx, this%root(), 'Direction', reshape(transpose(matrix),[9]))
    call err_ctx%restore(0)
  end subroutine
#:endfor

end module vtkhdf_image_file_type

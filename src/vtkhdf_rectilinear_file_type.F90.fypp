!!

#include "vtkhdf_assert.inc"

#:set reals = [('real32','real(real32)','H5T_NATIVE_FLOAT'), ('real64','real(real64)','H5T_NATIVE_DOUBLE')]

module vtkhdf_rectilinear_file_type

  use,intrinsic :: iso_fortran_env
  use vtkhdf_structured_base_class
  use vtkhdf_h5_c_binding
  use vtkhdf_h5
  use vtkhdf_h5e_context_type
  use vtkhdf_data_handle_types
  use vtkhdf_version_param
  use vtkhdf_file_modes, only: VTKHDF_STATIC, VTKHDF_FIXED_MESH
  implicit none
  private

  public :: vtkhdf_version, VTKHDF_STATIC, VTKHDF_FIXED_MESH
  public :: vtkhdf_cell_data_handle, vtkhdf_point_data_handle, vtkhdf_field_data_handle

  type, extends(vtkhdf_structured_base), public :: vtkhdf_rectilinear_file
    private
  contains
    procedure :: dataset_type, supports_mode
    generic :: write_mesh => write_mesh_real32, write_mesh_real64
    procedure, private :: write_mesh_real32, write_mesh_real64
  end type

contains

  pure logical function supports_mode(this, mode)
    class(vtkhdf_rectilinear_file), intent(in) :: this
    integer, intent(in) :: mode
    supports_mode = mode == VTKHDF_STATIC .or. mode == VTKHDF_FIXED_MESH
  end function

  pure function dataset_type(this) result(name)
    class(vtkhdf_rectilinear_file), intent(in) :: this
    character(:), allocatable :: name
    name = 'RectilinearGrid'
  end function

#:for kind, decl, h5type in reals
  subroutine write_mesh_${kind}$(this, point_bounds, x, y, z)
    class(vtkhdf_rectilinear_file), intent(inout) :: this
    integer(int32), intent(in) :: point_bounds(3,2)
    ${decl}$, intent(in) :: x(:), y(:), z(:)
    integer(int64) :: dims(3)
    type(vtkhdf_h5e_context) :: err_ctx
    call err_ctx%capture
    call this%define_logical_grid(point_bounds)
    dims = this%point_dimensions()
    ASSERT(this%ctx%identical([${kind}$]))
    if (this%ctx%rank == 0) then
      INSIST(all([size(x,kind=int64),size(y,kind=int64),size(z,kind=int64)] == dims))
    end if
    call h5_write_attr(this%ctx, this%root(), 'Dimensions', int(dims,int32))
    call h5_write_dataset(this%ctx, this%root(), 'XCoordinates', x, root=0)
    call h5_write_dataset(this%ctx, this%root(), 'YCoordinates', y, root=0)
    call h5_write_dataset(this%ctx, this%root(), 'ZCoordinates', z, root=0)
    call err_ctx%restore(0)
  end subroutine
#:endfor

end module vtkhdf_rectilinear_file_type

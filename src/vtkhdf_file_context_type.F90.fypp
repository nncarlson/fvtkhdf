!!
!! VTKHDF_FILE_CONTEXT
!!
!! Owned standalone file and communicator resources. Composite leaves leave
!! this component inactive and borrow the containing writer's context instead.
!! Cleanup is explicit and collective; implicit finalization performs no I/O.
!! Callers initialize the HDF5 bindings and establish the HDF5 error context.
!!
!! Copyright (c) 2026 Neil Carlson <neil.n.carlson@gmail.com>
!! SPDX-License-Identifier: BSD-2-Clause
!!

#include "vtkhdf_assert.inc"

module vtkhdf_file_context_type

  use vtkhdf_context_type
  use vtkhdf_h5_c_binding
  implicit none
  private

  type, public :: vtkhdf_file_context
    private
    integer(hid_t) :: file_id = H5I_INVALID_HID
    type(vtkhdf_context) :: ctx
  contains
    procedure :: open, close, flush, id, context
  end type

contains

#ifdef USE_MPI
  subroutine open(this, filename, comm, stat, errmsg)
#else
  subroutine open(this, filename, stat, errmsg)
#endif

    class(vtkhdf_file_context), intent(out) :: this
    character(*), intent(in) :: filename
#ifdef USE_MPI
    integer, intent(in) :: comm
#endif
    integer, intent(out) :: stat
    character(:), allocatable, intent(out) :: errmsg

    integer(hid_t) :: fapl
    integer :: ierr

#ifdef USE_MPI
    call this%ctx%init(comm)
#else
    call this%ctx%init()
#endif

    call this%ctx%get_fapl(fapl)
    this%file_id = H5Fcreate(filename, H5F_ACC_TRUNC, H5P_DEFAULT, fapl)
    ierr = H5Pclose(fapl)
    stat = 0
    if (this%ctx%global_any(this%file_id < 0)) then
      stat = 1
      errmsg = 'failed to open file'
      if (this%file_id >= 0) ierr = H5Fclose(this%file_id)
      this%file_id = H5I_INVALID_HID
      call this%ctx%free ! frees duplicated comm in MPI build
    end if

  end subroutine open

  subroutine close(this)
    class(vtkhdf_file_context), intent(inout) :: this
    integer :: ierr
    if (this%file_id < 0) return ! no owned file or communicator
    ierr = H5Fclose(this%file_id)
    INSIST(ierr >= 0)
    this%file_id = H5I_INVALID_HID
    call this%ctx%free()
  end subroutine

  subroutine flush(this)
    class(vtkhdf_file_context), intent(in) :: this
    integer :: ierr
    INSIST(this%file_id >= 0)
    ierr = H5Fflush(this%file_id, H5F_SCOPE_LOCAL)
    INSIST(ierr >= 0)
  end subroutine

  function id(this) result(file_id)
    class(vtkhdf_file_context), intent(in) :: this
    integer(hid_t) :: file_id
    file_id = this%file_id
  end function

  function context(this) result(ctx)
    class(vtkhdf_file_context), intent(in) :: this
    type(vtkhdf_context) :: ctx
    ctx = this%ctx ! unowned copy
  end function

end module

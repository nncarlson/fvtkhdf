!!
!! VTKHDF_FILE_CONTEXT
!!
!! Internal helper for owned HDF5 file and communicator resources.
!! File owners access ID and CTX directly; dataset writers borrow CTX.
!! Cleanup is explicit and collective; implicit finalization performs no I/O.
!! Callers initialize the HDF5 bindings and establish the HDF5 error context.
!!
!! SPDX-License-Identifier: BSD-2-Clause
!!

#include "vtkhdf_assert.inc"

module vtkhdf_file_context_type

  use vtkhdf_context_type
  use vtkhdf_h5_c_binding
  implicit none
  private

  type, public :: vtkhdf_file_context
    integer(hid_t) :: id = H5I_INVALID_HID
    type(vtkhdf_context) :: ctx
  contains
    procedure :: open, close, flush
  end type

contains

#ifdef USE_MPI
  subroutine open(this, filename, comm, stat, errmsg)
#else
  subroutine open(this, filename, stat, errmsg)
#endif

    class(vtkhdf_file_context), intent(out) :: this
    character(*), intent(in) :: filename
#ifdef USE_MPI
    integer, intent(in) :: comm
#endif
    integer, intent(out) :: stat
    character(:), allocatable, intent(out) :: errmsg

    integer(hid_t) :: fapl
    integer :: ierr

#ifdef USE_MPI
    call this%ctx%init(comm)
#else
    call this%ctx%init()
#endif

    call this%ctx%get_fapl(fapl)
    this%id = H5Fcreate(filename, H5F_ACC_TRUNC, H5P_DEFAULT, fapl)
    ierr = H5Pclose(fapl)
    stat = 0
    if (this%ctx%global_any(this%id < 0)) then
      stat = 1
      errmsg = 'failed to open file'
      if (this%id >= 0) ierr = H5Fclose(this%id)
      this%id = H5I_INVALID_HID
      call this%ctx%free ! frees duplicated comm in MPI build
    end if

  end subroutine open

  subroutine close(this)
    class(vtkhdf_file_context), intent(inout) :: this
    integer :: ierr
    if (this%id < 0) return ! no owned file or communicator
    ierr = H5Fclose(this%id)
    INSIST(ierr >= 0)
    this%id = H5I_INVALID_HID
    call this%ctx%free()
  end subroutine

  subroutine flush(this)
    class(vtkhdf_file_context), intent(in) :: this
    integer :: ierr
    INSIST(this%id >= 0)
    ierr = H5Fflush(this%id, H5F_SCOPE_LOCAL)
    INSIST(ierr >= 0)
  end subroutine

end module

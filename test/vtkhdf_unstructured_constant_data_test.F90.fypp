! Constant point/cell data, late creation, and independent geometry histories.
#:set nums = [('int8','integer(int8)','int'), ('int32','integer(int32)','int'), ('int64','integer(int64)','int'), ('real32','real(real32)','real'), ('real64','real(real64)','real')]
program vtkhdf_unstructured_constant_data_test
  use,intrinsic :: iso_fortran_env
  use vtkhdf_unstructured_file_type
  use vtkhdf_unstructured_writer_type, only: vtkhdf_unstructured_writer
  use vtkhdf_mb_file_type
  use vtkhdf_vtk_cell_types, only: VTK_TETRA
  use vtkhdf_test_env
#ifdef USE_MPI
  use mpi
#endif
  implicit none

  type :: writer_pointer
    class(vtkhdf_unstructured_writer), pointer :: p => null()
  end type
  type(vtkhdf_unstructured_file), target :: file
  type(vtkhdf_mb_file) :: mb
  type(vtkhdf_unstructured_block), pointer :: block
  type(writer_pointer) :: writers(2)
  type(vtkhdf_point_data_handle) :: point_var(2)
  type(vtkhdf_cell_data_handle) :: cell_var(2)
  real(real64), allocatable :: points(:,:), point_values(:), cell_values(:)
  integer, allocatable :: cnode(:), xcnode(:)
  integer(int8), allocatable :: types(:)
  integer :: rank, nproc, stat, scenario, mode, nwriter, nw, step, j, npoint, ncell
  character(64) :: filename
  character(:), allocatable :: errmsg

  call test_env_init(rank,nproc)
  ncell = rank+1
  if (nproc > 1 .and. rank == 0) ncell = 0 ! rank zero still writes offset metadata
  npoint = 4*ncell
  allocate(points(3,npoint),point_values(npoint),cell_values(ncell))
  cnode = [(j,j=1,npoint)]
  xcnode = [(4*j+1,j=0,ncell)]
  types = spread(VTK_TETRA,dim=1,ncopies=ncell)

  do scenario = 0,3
    mode = min(scenario,VTKHDF_MOVING_MESH)
    nwriter = 1
    if (scenario == 3) then
      nwriter = 2
#ifdef USE_MPI
      call mb%create('unstructured_constants_mb.vtkhdf',MPI_COMM_WORLD,stat,errmsg)
#else
      call mb%create('unstructured_constants_mb.vtkhdf',stat,errmsg)
#endif
      if (stat /= 0) error stop errmsg
      do nw = 1,nwriter
        call mb%add_block('solid',block,mode=mode)
        writers(nw)%p => block
      end do
    else
      write(filename,'(a,i0,a)') 'unstructured_constants_',mode,'.vtkhdf'
#ifdef USE_MPI
      call file%create(trim(filename),MPI_COMM_WORLD,stat,errmsg,mode=mode)
#else
      call file%create(trim(filename),stat,errmsg,mode=mode)
#endif
      if (stat /= 0) error stop errmsg
      writers(1)%p => file
    end if

    do nw = 1,nwriter
      call geometry(nw,0)
      call writers(nw)%p%write_mesh(points,cnode,xcnode,types)
      call writers(nw)%p%write_field_data('nproc',data=nproc)
      call constants(writers(nw)%p,'before',nw)
      if (mode /= VTKHDF_STATIC) then
        ! Collisions in both orders: point constant first, cell temporal first.
        call values(nw,0)
        call writers(nw)%p%write_point_data('shared.name',point_values)
        point_var(nw) = writers(nw)%p%register_temporal_point_data('shared name',0.0_real64)
        cell_var(nw) = writers(nw)%p%register_temporal_cell_data('shared.name',0.0_real64)
        call writers(nw)%p%write_cell_data('shared name',cell_values)
      end if
    end do

    if (mode /= VTKHDF_STATIC) then
      do step = 0,4
        if (scenario == 3) then
          call mb%start_time_step(real(step))
        else
          call file%start_time_step(real(step))
        end if
        do nw = 1,nwriter
          if (step == 0) call constants(writers(nw)%p,'during_first',nw)
          if (step == 1) call constants(writers(nw)%p,'during_later',nw)
          ! The constant just written must not lock out a coordinate update.
          if (mode == VTKHDF_MOVING_MESH .and. (step == 1 .or. step == 3)) then
            call geometry(nw,(step+1)/2)
            call writers(nw)%p%write_mesh_geometry(points)
          end if
          call values(nw,step)
          if (step /= 2 .and. step /= 4) call writers(nw)%p%write_point_data(point_var(nw),point_values)
          if (step /= 1 .and. step /= 4) call writers(nw)%p%write_cell_data(cell_var(nw),cell_values)
          if (step == 3) call constants(writers(nw)%p,'after_data',nw)
        end do
        ! Step 0 is finalized by START; the MB owner's CLOSE finalizes step 4.
        if (step == 0 .or. (scenario == 3 .and. step == 4)) cycle
        if (scenario == 3) then
          call mb%finalize_time_step()
        else
          call file%finalize_time_step()
        end if
        if (step == 2) then
          do nw = 1,nwriter
            call constants(writers(nw)%p,'between',nw)
          end do
        end if
      end do
    end if

    do nw = 1,nwriter
      ! After every finalized step in standalone files; in the final open MB step.
      call constants(writers(nw)%p,'after',nw)
      if (mode /= VTKHDF_STATIC) then
        call values(nw,0)
        call writers(nw)%p%write_point_data('shared name',point_values)
        call writers(nw)%p%write_cell_data('shared name',cell_values)
      end if
    end do
    if (scenario == 3) then
      call mb%close()
      nullify(block)
    else
      call file%close()
    end if
    do nw = 1,nwriter
      nullify(writers(nw)%p)
    end do
  end do
  call test_env_finalize()

contains

  subroutine geometry(nw,shift)
    integer, intent(in) :: nw, shift
    integer :: cell
    do cell = 1,ncell
      points(:,4*cell-3:4*cell) = reshape([0.,0.,0.,1.,0.,0.,0.,1.,0.,0.,0.,1.],[3,4])
      points(1,4*cell-3:4*cell) = points(1,4*cell-3:4*cell)+100*(nw-1)+10*rank+2*(cell-1)
    end do
    points(3,:) = points(3,:)+shift
  end subroutine

  subroutine values(nw,step)
    integer, intent(in) :: nw, step
    point_values = [(50*(nw-1)+10*rank+j+1000*step,j=1,npoint)]
    cell_values = [(50*(nw-1)+10*rank+j+1000*step,j=1,ncell)]
  end subroutine

  subroutine constants(writer,prefix,nw)
    class(vtkhdf_unstructured_writer), intent(inout) :: writer
    character(*), intent(in) :: prefix
    integer, intent(in) :: nw
    integer :: j, c
    character(7) :: scalar_role, vector_role
#:for kind, decl, cast in nums
    ${decl}$ :: point_${kind}$(npoint), cell_${kind}$(ncell)
    ${decl}$ :: point_vector_${kind}$(3,2*npoint), cell_vector_${kind}$(3,2*ncell)
#:endfor
#:for kind, decl, cast in nums
    scalar_role = ''
    vector_role = ''
#:if kind == 'real64'
    if (prefix == 'before') then
      scalar_role = 'Scalars'
      vector_role = 'Vectors'
    end if
#:endif
    point_${kind}$ = [(${cast}$(50*(nw-1)+10*rank+j,${kind}$),j=1,npoint)]
    cell_${kind}$ = [(${cast}$(50*(nw-1)+10*rank+j,${kind}$),j=1,ncell)]
    do c = 1,3
      point_vector_${kind}$(c,::2) = point_${kind}$+c
      cell_vector_${kind}$(c,::2) = cell_${kind}$+c
    end do
    call writer%write_point_data(prefix//' point ${kind}$ scalar',point_${kind}$,attribute=scalar_role)
    call writer%write_point_data(prefix//' point ${kind}$ vector',point_vector_${kind}$(:,::2),attribute=vector_role)
    call writer%write_cell_data(prefix//' cell ${kind}$ scalar',cell_${kind}$,attribute=scalar_role)
    call writer%write_cell_data(prefix//' cell ${kind}$ vector',cell_vector_${kind}$(:,::2),attribute=vector_role)
#:endfor
  end subroutine
end program

! Geometry and common data paths for both explicit structured grid types.
! Each process owns one-point x slabs in cyclic order, with an array halo.
program vtkhdf_grid_test
  use,intrinsic :: iso_fortran_env
  use vtkhdf_rectilinear_file_type
  use vtkhdf_structured_file_type
  use vtkhdf_test_env
#ifdef USE_MPI
  use mpi
#endif
  implicit none
  integer :: rank, nproc, mask

  call test_env_init(rank, nproc)
  do mask = 1, 7
#:for grid in ['rectilinear','structured']
#:for kind in ['real32','real64']
    call ${grid}$_${kind}$(mask, .false.)
    call ${grid}$_${kind}$(mask, .true.)
#:endfor
#:endfor
  end do
  call test_env_finalize()

contains

#:for grid in ['rectilinear','structured']
#:for kind in ['real32','real64']
  subroutine ${grid}$_${kind}$(mask, temporal)
    integer, intent(in) :: mask
    logical, intent(in) :: temporal
    type(vtkhdf_${grid}$_file) :: file
    type(vtkhdf_point_data_handle) :: point_var
    type(vtkhdf_cell_data_handle) :: cell_var
    type(vtkhdf_field_data_handle) :: field_var
    real(${kind}$), allocatable :: points(:,:,:,:), values(:,:,:), cells(:,:,:), x(:), y(:), z(:)
    integer :: dims(3), cdims(3), bounds(3,2), origin(3), selection(3,2)
    integer :: i, j, k, ix, round, step, first, last, mode, stat
    character(100) :: filename
    character(:), allocatable :: errmsg

    dims = 1
    if (btest(mask,0)) dims(1) = 5
    if (btest(mask,1)) dims(2) = 3
    if (btest(mask,2)) dims(3) = 2
    cdims = max(1,dims-1)
    bounds(:,1) = [10,-2,7]
    bounds(:,2) = bounds(:,1) + dims - 1
    mode = VTKHDF_STATIC
    if (temporal) mode = VTKHDF_FIXED_MESH
    write(filename,'(a,i0,a,i0,a)') '${grid}$_${kind}$_',mask,'_',merge(1,0,temporal),'.vtkhdf'
#ifdef USE_MPI
    call file%create(trim(filename), MPI_COMM_WORLD, stat, errmsg, mode=mode, data_chunk_bytes=64_int64)
#else
    call file%create(trim(filename), stat, errmsg, mode=mode, data_chunk_bytes=64_int64)
#endif
    if (stat /= 0) error stop errmsg
#:if grid == 'rectilinear'
    if (rank == 0) then
      x = [(real(i*i,${kind}$),i=0,dims(1)-1)]
      y = [(real(2*j*j+1,${kind}$),j=0,dims(2)-1)]
      z = [(real(3*k*k-1,${kind}$),k=0,dims(3)-1)]
    else
      ! Values and lengths on nonwriters must be ignored (including zero).
      allocate(x(0),y(2),z(0))
      y = -999
    end if
    call file%write_mesh(bounds,x,y,z)
#:else
    call file%write_mesh(bounds)
    do round = 0, (dims(1)-1)/nproc
      ix = 1 + rank + round*nproc
      origin = bounds(:,1) + [ix-2,0,0]
      selection(:,1) = bounds(:,1) + [ix-1,0,0]
      selection(:,2) = bounds(:,2)
      selection(1,2) = selection(1,1)
      if (ix <= dims(1)) then
        allocate(points(3,6,dims(2),dims(3)))
        points = -999
        do k = 1,dims(3)
          do j = 1,dims(2)
            do i = 1,3
              ! Odd columns form a noncontiguous array with an x halo.
              points(:,2*i-1,j,k) = [real(ix+i-3,${kind}$) + 0.125_${kind}$*(j-1)**2, &
                  2.0_${kind}$*(j-1) + 0.25_${kind}$*(k-1)**2, &
                  3.0_${kind}$*(k-1) + 0.5_${kind}$*(ix+i-3)*(j-1)]
            end do
          end do
        end do
        call file%write_mesh_geometry(points(:,::2,:,:),origin,selection)
      else
        allocate(points(3,0,dims(2),dims(3)))
        call file%write_mesh_geometry(points,[huge(0),huge(0),huge(0)])
      end if
      deallocate(points)
    end do
    ! Explicit empty bounds also accept a nonempty buffer outside the grid.
    allocate(points(3,1,1,1))
    points = -999
    call file%write_mesh_geometry(points,[0,0,0],reshape([1,1,1,0,0,0],[3,2]))
#:endif
    if (temporal) then
      point_var = file%register_temporal_point_data('value',0.0_${kind}$,attribute='Scalars')
      field_var = file%register_temporal_field_data('energy',0.0_${kind}$)
    else
      call file%write_field_data('energy',42.0_${kind}$)
    end if
    ! Cell regions use a different partition from geometry/point regions.
    first = rank*cdims(1)/nproc + 1
    last = (rank+1)*cdims(1)/nproc
    allocate(cells(last-first+1,cdims(2),cdims(3)))
    do k = 1,cdims(3)
      do j = 1,cdims(2)
        do i = first,last
          cells(i-first+1,j,k) = i-1 + 10*(j-1) + 100*(k-1)
        end do
      end do
    end do
    call file%write_cell_data('cell',cells,bounds(:,1)+[first-1,0,0],handle=cell_var)
    do step = 0, merge(2,0,temporal)
      if (temporal) call file%start_time_step(real(step,${kind}$))
      if (step /= 1) then
        do round = 0,(dims(1)-1)/nproc
          ix = 1 + rank + round*nproc
          allocate(values(merge(1,0,ix<=dims(1)),dims(2),dims(3)))
          do k = 1,dims(3)
            do j = 1,dims(2)
              if (ix<=dims(1)) values(1,j,k) = ix-1 + 10*(j-1) + 100*(k-1) + 100*step
            end do
          end do
          origin = bounds(:,1) + [ix-1,0,0]
          if (.not.temporal .and. round == 0) then
            call file%write_point_data('value',values,origin,handle=point_var,attribute='Scalars')
          else
            call file%write_point_data(point_var,values,origin)
          end if
          deallocate(values)
        end do
      end if
      if (temporal) call file%write_field_data(field_var,42.0_${kind}$+step)
    end do
    ! Close must finalize the last step and release all geometry/data resources.
    call file%flush()
    call file%close()
    call file%close()
    ! Reuse the same wrapper after close, exercising reset of the dynamic type.
#ifdef USE_MPI
    call file%create('reuse_${grid}$.vtkhdf',MPI_COMM_WORLD,stat,errmsg)
#else
    call file%create('reuse_${grid}$.vtkhdf',stat,errmsg)
#endif
    if (stat /= 0) error stop errmsg
    call file%close()
  end subroutine
#:endfor
#:endfor
end program
